generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  nombre       String
  email        String    @unique
  passwordHash String
  rol          String    @default("ADMIN") // OWNER | ADMIN | RECEPCION | MANICURISTA
  activo       Boolean   @default(true)
  staffId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Staff {
  id           String         @id @default(uuid())
  nombre       String
  foto         String
  color        String         @default("#5CC6BF")
  activo       Boolean        @default(true)
  bio          String?
  orden        Int            @default(0)
  servicios    StaffService[]
  citas        Appointment[]
  bloqueos     TimeBlock[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ServiceCategory {
  id        String    @id @default(uuid())
  nombre    String    @unique
  slug      String    @unique
  orden     Int       @default(0)
  servicios Service[]
}

model Service {
  id                String         @id @default(uuid())
  slug              String         @unique
  nombre            String
  categoryId        String
  category          ServiceCategory @relation(fields: [categoryId], references: [id])
  descripcionCorta  String
  descripcionLarga  String
  precio            Float
  precioDesde       Boolean        @default(false)
  duracionMinutos   Int            @default(60)
  bufferMinutos     Int            @default(15)
  imagenPrincipal   String
  galeria           String?        // JSON string
  caracteristicas   String         // JSON string array
  coloresPopulares  String         // JSON string array of hex
  destacado         Boolean        @default(false)
  activo            Boolean        @default(true)
  orden             Int            @default(0)
  metaTitle         String?
  metaDescription   String?
  staff             StaffService[]
  citas             Appointment[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model StaffService {
  id        String   @id @default(uuid())
  staffId   String
  serviceId String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model Customer {
  id             String        @id @default(uuid())
  nombre         String
  celular        String        @unique
  email          String?
  notasInternas  String?
  totalCitas     Int           @default(0)
  inasistencias  Int           @default(0)
  sellos         Int           @default(0) // sellos en la tarjeta en curso
  sellosTotal    Int           @default(0) // sellos ganados en total (histórico)
  ultimaVisita   DateTime?
  citas          Appointment[]
  rewards        Reward[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Reward {
  id          String    @id @default(uuid())
  codigo      String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  premio      String    // descripción del premio al momento de ganarlo
  estado      String    @default("DISPONIBLE") // DISPONIBLE | CANJEADO | EXPIRADO
  ganadoEn    DateTime  @default(now())
  canjeadoEn  DateTime?
  expiraEn    DateTime?
  createdAt   DateTime  @default(now())

  @@index([customerId])
  @@index([estado])
}

model Appointment {
  id                String           @id @default(uuid())
  codigo            String           @unique
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  serviceId         String
  service           Service          @relation(fields: [serviceId], references: [id])
  staffId           String
  staff             Staff            @relation(fields: [staffId], references: [id])
  startAt           DateTime
  endAt             DateTime
  precio            Float
  estado            String           @default("PENDIENTE") // PENDIENTE | CONFIRMADA | COMPLETADA | CANCELADA | NO_ASISTIO
  origen            String           @default("WEB") // WEB | ADMIN | WHATSAPP | TELEFONO
  notasCliente      String?
  notasInternas     String?
  canceladoPor      String?
  motivoCancelacion String?
  selloOtorgado     Boolean          @default(false) // evita contar el sello dos veces
  pagado            Boolean          @default(false)
  resenaEstrellas   Int?             // calificación privada del cliente (1-5)
  resenaTexto       String?          // nota privada sobre el cliente/atención
  logs              AppointmentLog[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([staffId, startAt, endAt])
  @@index([startAt])
  @@index([codigo])
}

model AppointmentLog {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  accion        String
  detalle       String?
  realizadoPor  String      @default("SISTEMA")
  fecha         DateTime    @default(now())
}

model BusinessHours {
  id           String  @id @default(uuid())
  diaSemana    Int     // 0=Domingo, 1=Lunes, ... 6=Sabado
  horaApertura String  // "09:00"
  horaCierre   String  // "20:00"
  cerrado      Boolean @default(false)
  staffId      String?
}

model TimeBlock {
  id        String   @id @default(uuid())
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])
  startAt   DateTime
  endAt     DateTime
  motivo    String
  createdAt DateTime @default(now())
}

model Post {
  id               String    @id @default(uuid())
  slug             String    @unique
  titulo           String
  extracto         String
  contenidoHtml    String
  contenidoJson    String?
  imagenPortada    String
  categoria        String    @default("Tendencias")
  estado           String    @default("PUBLICADO") // BORRADOR | PROGRAMADO | PUBLICADO
  fechaPublicacion DateTime  @default(now())
  autor            String    @default("Nails Express")
  destacado        Boolean   @default(false)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model GalleryItem {
  id          String   @id @default(uuid())
  imagen      String
  categoria   String   // Manicure | Pedicure | Diseños | Temporada
  altText     String
  serviceId   String?
  orden       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Faq {
  id        String   @id @default(uuid())
  pregunta  String
  respuesta String
  orden     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  nombre    String
  texto     String
  avatar    String?
  estrellas Int      @default(5)
  servicio  String?  // ej. "Manicure en gel"
  orden     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

