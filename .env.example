# Database connection (SQLite for local dev or PostgreSQL on Supabase)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true"

# Initial Admin credentials
ADMIN_EMAIL="admin@nailsexpress.com"
ADMIN_PASSWORD="admin123Nails!"

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone
TZ="America/Lima"

# Supabase (optional for image storage / production auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend for transaction emails (optional)
RESEND_API_KEY="re_123456789"
