# ==========================================================================
# Nails Express — variables de entorno (copiar a .env y completar)
# ==========================================================================

# --- Base de datos: Supabase (PostgreSQL) ---
# En Supabase: Project Settings → Database → Connection string.
# DATABASE_URL usa el pooler (puerto 6543) para la app.
# DIRECT_URL usa la conexión directa (puerto 5432) para las migraciones.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Secreto de sesión del admin (OBLIGATORIO en producción, 32+ caracteres) ---
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET=""

# --- Credenciales iniciales del admin (solo se usan al correr el seed) ---
ADMIN_EMAIL="admin@nailsexpress.com"
ADMIN_PASSWORD="cambia-esta-clave"

# --- Secreto para la tarea programada de recordatorios ---
CRON_SECRET=""

# --- URL pública de la app ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Zona horaria ---
TZ="America/Lima"

# --- Supabase Storage (para fotos subidas; opcional en local) ---
# Sin esto, las subidas caen a /public/uploads (solo desarrollo local).
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# --- Email transaccional (opcional) ---
# RESEND_API_KEY=""
