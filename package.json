    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
